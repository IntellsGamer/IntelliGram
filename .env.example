# Copy to .env for local self-hosted configuration. Do not commit the real .env.
INTELLIGRAM_DEVELOPMENT_MODE=true
INTELLIGRAM_PUBLIC_LINK_BASE_URL=https://intelligram.local

# Normalized phone identifier of the only IntelliGram account allowed to use /admin.
# Example only — replace with the owner account’s own phone identifier.
INTELLIGRAM_ADMIN_PHONE=+15555550100

# Set a long random production token secret outside development mode.
# INTELLIGRAM_TOKEN_SECRET=replace-with-a-long-random-secret
